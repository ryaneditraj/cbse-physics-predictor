# Optional OCR for scanned question papers. The app does not read this file
# automatically. Export the variables yourself:
#
#   set -a
#   source .env.example
#   set +a
#
# Leave OCR off unless you installed the extra: pip install -e ".[ocr]"
# and have Tesseract plus Poppler on your machine.

CBSE_PHYSICS_OCR=0

# Optional path to the tesseract binary. Empty uses whatever is on PATH.
# Must be a plain path. Shell syntax is rejected.
CBSE_PHYSICS_TESSERACT_CMD=
